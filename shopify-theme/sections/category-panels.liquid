<section class="section" aria-label="{{ section.settings.aria_label | default: 'Shop by category' }}" style="padding-top:0">
  <div class="container category-panels">
    {%- for block in section.blocks -%}
      {%- assign coll = collections[block.settings.collection] -%}
      <a class="category-panel {{ block.settings.modifier }} card-media-link" href="{{ coll.url | default: block.settings.link }}" data-reveal {{ block.shopify_attributes }}>
        <div class="category-art" aria-hidden="true">
          {%- if block.settings.illustration != blank -%}
            <svg viewBox="0 0 360 480"><use href="#illo-{{ block.settings.illustration }}"/></svg>
          {%- endif -%}
        </div>
        <div class="category-copy">
          <h3>{{ block.settings.heading }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          <span class="text-link">{{ block.settings.link_text }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category panels",
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Dresses" },
        { "type": "text", "id": "text", "label": "Text", "default": "Bias cuts and cowl necks in satin with real weight. £55–70." },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Shop dresses" },
        {
          "type": "select", "id": "modifier", "label": "Gradient", "default": "category-panel--dresses",
          "options": [
            { "value": "category-panel--dresses", "label": "Wine" },
            { "value": "category-panel--tops", "label": "Noir" }
          ]
        },
        {
          "type": "select", "id": "illustration", "label": "Illustration", "default": "chapel",
          "options": [
            { "value": "chapel", "label": "Chapel" },
            { "value": "aria", "label": "Aria" },
            { "value": "vesper", "label": "Vesper" },
            { "value": "encore", "label": "Encore" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Category panels",
      "blocks": [
        { "type": "panel", "settings": { "heading": "Dresses", "modifier": "category-panel--dresses", "illustration": "chapel" } },
        { "type": "panel", "settings": { "heading": "Going-Out Tops", "text": "Halters, corsets and structure that holds until last orders. £30–40.", "link_text": "Shop tops", "modifier": "category-panel--tops", "illustration": "aria" } }
      ]
    }
  ]
}
{% endschema %}
