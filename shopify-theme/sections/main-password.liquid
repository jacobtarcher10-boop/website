{%- comment -%}
  Password / coming-soon page.
  Both the wordmark and the message below are editable in the theme editor
  (Online Store → Themes → Customize → pick the "Password" template), or in
  code via the schema defaults at the bottom of this file.
  The Didot wordmark styling and web font live in layout/password.liquid.
{%- endcomment -%}
<div class="password-inner">
  <p class="password-brand">{{ section.settings.brand | default: shop.name }}</p>

  {%- if section.settings.subtext != blank -%}
    <p class="lede password-sub">{{ section.settings.subtext }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'newsletter-form password-form' -%}
    <label class="visually-hidden" for="password">{{ section.settings.input_label }}</label>
    <input type="password" name="password" id="password" placeholder="{{ section.settings.input_label }}" autocomplete="off">
    <button type="submit">{{ section.settings.button_label }}</button>
  {%- endform -%}

  {%- if form.errors -%}
    <p class="newsletter-note" style="color: var(--rose)">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "Wordmark",
      "info": "Leave blank to use the store name.",
      "default": "Rose Archer"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Message",
      "default": "The founding drop is coming. The list hears first."
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Password field placeholder",
      "default": "Enter password"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter"
    }
  ]
}
{% endschema %}
