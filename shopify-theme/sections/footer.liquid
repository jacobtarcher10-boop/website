<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
        <p>{{ section.settings.blurb }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <nav class="footer-col" aria-label="{{ block.settings.heading }}" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>
            <ul role="list">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer-base">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ section.settings.tagline }}</p>
      {%- if section.settings.social_heading != blank or shop.instagram_url or section.settings.instagram -%}
        <div class="footer-social">
          {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" rel="noopener">Instagram</a>{%- endif -%}
          {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" rel="noopener">TikTok</a>{%- endif -%}
          {%- if section.settings.pinterest != blank -%}<a href="{{ section.settings.pinterest }}" rel="noopener">Pinterest</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "blurb", "label": "Brand blurb", "default": "Occasion wear in small limited drops. Designed in the UK by Olivia, kept on the rails by Jacob." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Dressed for the nights that count." },
    { "type": "header", "content": "Social" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "pinterest", "label": "Pinterest URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "World" } }
      ]
    }
  ]
}
{% endschema %}
