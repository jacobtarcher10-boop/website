<section class="newsletter section" id="newsletter" aria-labelledby="newsletter-title-{{ section.id }}">
  <div class="container newsletter-inner" data-reveal>
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 id="newsletter-title-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="newsletter-thanks" role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="newsletter-email-{{ section.id }}">Email address</label>
        <input id="newsletter-email-{{ section.id }}" type="email" name="contact[email]" placeholder="Your email address" autocomplete="email" required>
        <button type="submit">Join</button>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.note != blank -%}<p class="newsletter-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 02 is already on the cutting table" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The list hears first." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Drop dates, early access, and nothing else. We write rarely and only when it matters." },
    { "type": "text", "id": "note", "label": "Note", "default": "Unsubscribe whenever. We’d rather be missed than muted." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
