{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.product_limit | default: 4
-%}
<section class="section" aria-labelledby="edit-title-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 id="edit-title-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_text != blank -%}
        <a class="text-link" href="{{ coll.url | default: section.settings.link_url }}">{{ section.settings.link_text }}</a>
      {%- endif -%}
    </div>

    {%- if coll != blank and coll.products.size > 0 -%}
      {%- comment -%} Desktop (>=960px): numbered index that cross-fades the preview {%- endcomment -%}
      <div class="edit-showcase" data-edit-showcase data-reveal>
        <ol class="edit-list" role="list">
          {%- for product in coll.products limit: limit -%}
            <li>
              <a class="edit-row{% if forloop.first %} is-active{% endif %}" href="{{ product.url }}" data-edit-item="{{ product.handle }}">
                <span class="edit-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="edit-name">{{ product.title }}</span>
                <span class="edit-detail">
                  {%- if product.metafields.custom.subtitle != blank -%}<span class="edit-meta">{{ product.metafields.custom.subtitle }}</span>{%- endif -%}
                  <span class="edit-price">{{ product.price | money }}</span>
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ol>
        <div class="edit-preview" aria-hidden="true">
          {%- for product in coll.products limit: limit -%}
            <figure class="product-media {{ product.metafields.custom.card_tone | default: 'media--blush' }}{% if forloop.first %} is-active{% endif %}" data-edit-preview="{{ product.handle }}">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 720 | image_tag: loading: 'lazy', alt: product.title }}
              {%- elsif product.metafields.custom.illustration != blank -%}
                <svg viewBox="0 0 360 480"><use href="#illo-{{ product.metafields.custom.illustration }}"/></svg>
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Below 960px: standard card grid {%- endcomment -%}
      <div class="product-grid product-grid--4">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="lede">Choose a collection for this section in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Founding edit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01 · Spring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The founding edit" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View the drop" },
    { "type": "url", "id": "link_url", "label": "Link (if no collection)" }
  ],
  "presets": [{ "name": "Founding edit" }]
}
{% endschema %}
