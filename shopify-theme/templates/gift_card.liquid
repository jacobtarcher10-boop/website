<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ gift_card.initial_value | money }} gift card — {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root { --bg:{{ settings.color_bg }}; --surface:{{ settings.color_surface }}; --text:{{ settings.color_text }}; --cream:{{ settings.color_text }}; --accent:{{ settings.color_accent }}; --rose:{{ settings.color_rose }}; --gold:{{ settings.color_gold }}; --muted:{{ settings.color_muted }}; }
    .gift-card { min-height:100vh; display:grid; place-items:center; text-align:center; padding:var(--gutter); }
    .gift-card__value { font-family:var(--font-display); font-size:clamp(3rem,10vw,6rem); color:var(--gold); }
    .gift-card__code { display:inline-block; margin-top:1.5rem; padding:0.8rem 1.4rem; border:1px solid var(--hairline-strong); letter-spacing:0.2em; }
  </style>
</head>
<body class="template-gift-card">
  <main class="gift-card">
    <div>
      <span class="eyebrow">{{ shop.name }}</span>
      <p class="gift-card__value">{{ gift_card.initial_value | money }}</p>
      <p class="lede" style="margin-inline:auto">A gift card for the nights that count.</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <p class="newsletter-note" style="margin-top:1.5rem">Balance: {{ gift_card.balance | money }}</p>
    </div>
  </main>
</body>
</html>
