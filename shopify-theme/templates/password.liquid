{% layout 'password' %}
<div class="container">
  <span class="eyebrow">{{ shop.name }}</span>
  <h1 class="display" style="font-size:clamp(2.4rem,6vw,4rem)">Dressed for <span class="accent-italic">the nights that count.</span></h1>
  <p class="lede" style="margin:1.25rem auto 2rem">{{ page_description | default: 'The founding drop is coming. The list hears first.' }}</p>

  {%- form 'storefront_password', class: 'newsletter-form', style: 'max-width:26rem;margin-inline:auto' -%}
    <label class="visually-hidden" for="password">Enter store password</label>
    <input type="password" name="password" id="password" placeholder="Enter password" autocomplete="off">
    <button type="submit">Enter</button>
  {%- endform -%}

  {%- if form.errors -%}<p class="newsletter-note" style="color:var(--rose)">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>{%- endif -%}
</div>
