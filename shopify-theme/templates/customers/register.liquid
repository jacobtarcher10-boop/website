<div class="container section" style="max-width:34rem">
  <h1 style="text-align:center">Create account</h1>
  {%- form 'create_customer', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="reg-first">First name</label>
    <input type="text" name="customer[first_name]" id="reg-first" autocomplete="given-name">
    <label for="reg-last">Last name</label>
    <input type="text" name="customer[last_name]" id="reg-last" autocomplete="family-name">
    <label for="reg-email">Email</label>
    <input type="email" name="customer[email]" id="reg-email" autocomplete="email" required>
    <label for="reg-password">Password</label>
    <input type="password" name="customer[password]" id="reg-password" autocomplete="new-password" required>
    <button class="btn btn--primary btn--full" type="submit">Create</button>
  {%- endform -%}
  <p style="text-align:center;margin-top:1.5rem"><a href="{{ routes.account_login_url }}">Back to sign in</a></p>
</div>
