<div class="container section" style="max-width:34rem">
  <h1 style="text-align:center">Reset password</h1>
  {%- form 'reset_customer_password', class: 'account-form' -%}
    {{ form.errors | default_errors }}
    <label for="reset-password">New password</label>
    <input type="password" name="customer[password]" id="reset-password" autocomplete="new-password" required>
    <label for="reset-confirm">Confirm password</label>
    <input type="password" name="customer[password_confirmation]" id="reset-confirm" autocomplete="new-password" required>
    <button class="btn btn--primary btn--full" type="submit">Reset</button>
  {%- endform -%}
</div>
