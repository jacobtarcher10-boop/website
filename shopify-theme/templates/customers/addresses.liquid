<div class="container section" style="max-width:40rem">
  <div class="section-head section-head--split">
    <div><h1>Addresses</h1></div>
    <a class="text-link" href="{{ routes.account_url }}">Back to account</a>
  </div>

  {%- form 'customer_address', customer.new_address, class: 'account-form' -%}
    <h2 style="font-size:1.4rem">Add a new address</h2>
    <label for="addr-first">First name</label>
    <input type="text" name="address[first_name]" id="addr-first" autocomplete="given-name">
    <label for="addr-last">Last name</label>
    <input type="text" name="address[last_name]" id="addr-last" autocomplete="family-name">
    <label for="addr-1">Address</label>
    <input type="text" name="address[address1]" id="addr-1" autocomplete="address-line1">
    <label for="addr-city">City</label>
    <input type="text" name="address[city]" id="addr-city" autocomplete="address-level2">
    <label for="addr-zip">Postcode</label>
    <input type="text" name="address[zip]" id="addr-zip" autocomplete="postal-code">
    <label for="addr-country">Country</label>
    <select name="address[country]" id="addr-country" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
    <button class="btn btn--primary btn--full" type="submit">Save address</button>
  {%- endform -%}

  {%- for address in customer.addresses -%}
    <div style="border-top:1px solid var(--hairline);padding-top:1.25rem;margin-top:1.5rem">
      <p>{{ address | format_address }}</p>
      <a class="text-link" href="{{ address.url }}" data-address-edit>Edit</a>
    </div>
  {%- endfor -%}
</div>
