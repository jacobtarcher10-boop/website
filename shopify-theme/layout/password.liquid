<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --bg: {{ settings.color_bg }}; --surface: {{ settings.color_surface }};
      --text: {{ settings.color_text }}; --cream: {{ settings.color_text }};
      --accent: {{ settings.color_accent }}; --accent-strong: {{ settings.color_accent_strong }};
      --rose: {{ settings.color_rose }}; --gold: {{ settings.color_gold }};
      --wine: {{ settings.color_wine }}; --wine-soft: {{ settings.color_wine_soft }};
      --muted: {{ settings.color_muted }};
    }
    .password-page { min-height: 100vh; display: grid; place-items: center; text-align: center; padding: var(--gutter); }
  </style>
</head>
<body class="template-password">
  <main class="password-page">
    {{ content_for_layout }}
  </main>
</body>
</html>
