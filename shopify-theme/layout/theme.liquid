<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.color_bg -%}
    <meta name="theme-color" content="{{ settings.color_bg }}">
  {%- endif -%}

  <title>
    {{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% comment %} Fonts — swap here and in the two --font variables below to retheme {% endcomment %}
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300;1,9..144,400&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- comment -%} Palette from theme settings overrides the stylesheet defaults {%- endcomment -%}
  <style>
    :root {
      --bg: {{ settings.color_bg }};
      --surface: {{ settings.color_surface }};
      --text: {{ settings.color_text }};
      --cream: {{ settings.color_text }};
      --accent: {{ settings.color_accent }};
      --accent-strong: {{ settings.color_accent_strong }};
      --rose: {{ settings.color_rose }};
      --gold: {{ settings.color_gold }};
      --wine: {{ settings.color_wine }};
      --wine-soft: {{ settings.color_wine_soft }};
      --muted: {{ settings.color_muted }};
    }
  </style>

  <script>
    // Config the theme's JS reads (see assets/global.js)
    window.RoseArcher = {
      routes: {
        cart: "{{ routes.cart_url }}",
        cartAdd: "{{ routes.cart_add_url }}",
        cartChange: "{{ routes.cart_change_url }}"
      },
      cartDrawerEnabled: {{ settings.cart_drawer_enabled | default: true | json }},
      freeShippingThreshold: {{ settings.free_shipping_threshold | default: 50 | times: 100 | json }},
      moneyFormat: {{ shop.money_format | json }},
      strings: {
        freeReached: {{ 'sections.cart.free_shipping_reached' | t | json }},
        freeRemaining: {{ 'sections.cart.free_shipping_remaining' | t: amount: '__amount__' | json }},
        selectSize: {{ 'products.product.select_size' | t | json }},
        empty: {{ 'sections.cart.empty' | t | json }}
      }
    };
  </script>
</head>

<body class="template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {%- comment -%} Shared illustration sprite — placeholder line art for products without photography {%- endcomment -%}
  {% render 'garment-illustrations' %}

  {% sections 'header-group' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'cart-drawer' %}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
